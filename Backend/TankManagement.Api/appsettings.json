{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=tanques;User ID=root;Password=root;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ArduinoSerial": {
    "PortName": "COM3",
    "BaudRate": 115200,
    "DataBits": 8,
    "Parity": "None",
    "StopBits": "One",
    "DtrEnable": true,
    "ReconnectDelaySeconds": 5,
    "CommandTimeoutSeconds": 4,
    "MaxLineLength": 256,
    "DefaultTankId": 3,
    "MaxDistanceCm": 450,
    "NoDataTimeoutSeconds": 60
  }
}
